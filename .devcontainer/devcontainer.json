{
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "postCreateCommand": "pip install virtualenv && make install && make upstream-sync",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "GitHub.vscode-pull-request-github",
        "ms-vscode.makefile-tools",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
